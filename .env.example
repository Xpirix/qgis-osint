# ── Required ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_to_something_strong

# ── Strongly recommended ───────────────────────────────────────────────────────
# Raises GitHub API limit from 60 to 5,000 req/hr.
# Create at: https://github.com/settings/tokens → "Generate new token (classic)"
# Leave ALL checkboxes empty — public repo read access is sufficient.
GITHUB_TOKEN=

# ── Optional — public domain ───────────────────────────────────────────────────
# Caddy provisions Let's Encrypt TLS automatically when set.
# Leave as localhost for local dev (HTTP only).
DOMAIN=localhost

# ── Optional — Telegram feed ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=osint_matrix
POSTGRES_USER=qgis

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://cache:6379/0

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Cache ──────────────────────────────────────────────────────────────────────
PROXY_CACHE_TTL=3600

# ── Worker intervals (seconds) ─────────────────────────────────────────────────
FETCH_INTERVAL_COMMITS=300
FETCH_INTERVAL_RSS=900
FETCH_INTERVAL_PLUGINS=600
FETCH_INTERVAL_HUB=1800
FETCH_INTERVAL_ANALYTICS=86400
FETCH_INTERVAL_SCRAPE=604800
FETCH_INTERVAL_LAYERS=3600
